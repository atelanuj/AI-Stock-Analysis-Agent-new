NVIDIA_API_KEY=replace_me
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
DATABASE_URL=postgresql://stockai:stockai@postgres:5432/stockai
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300
AI_TEMPERATURE=0.3
AI_TOP_P=0.95
AI_MAX_TOKENS=8192
AI_ENABLE_THINKING=true
AI_REASONING_BUDGET=8192
# V6 performance/cache tuning
MARKET_HISTORY_CACHE_TTL_SECONDS=300
INTRADAY_CACHE_TTL_SECONDS=60
FUNDAMENTALS_CACHE_TTL_SECONDS=21600
NEWS_CACHE_TTL_SECONDS=900
EVENTS_CACHE_TTL_SECONDS=3600
BENCHMARK_CACHE_TTL_SECONDS=900
AI_CACHE_TTL_SECONDS=1800
MARKET_DATA_TIMEOUT_SECONDS=10
MARKET_DATA_RETRIES=2


# V6 data-validation tuning
QUOTE_TIMEOUT_SECONDS=6
QUOTE_CACHE_TTL_SECONDS=30
QUOTE_WARNING_DIFFERENCE_PCT=1.5
